procedure UseRTL;
var
  F: Text;
  U: file;
  gCount: Integer;
  Buf: array[0..15] of Byte;
begin
  gLong := 1;
  Str(gLong, gStr);
  Val(gStr, gLong, Integer(gHandle));
  gStr := Copy(gStr, 1, 2) + IntToStr(gLong) + Format('%d', [gLong]);
  gLong := Pos('a', gStr);
  Insert('x', gStr, 1); Delete(gStr, 1, 1);
  gStr := UpperCase(gStr) + LowerCase(gStr);
  gStr := IntToHex(gLong, 8) + FloatToStr(Sqrt(gLong)) + DateTimeToStr(Now);
  gLong := StrToIntDef(gStr, 0); gLong := Round(Sin(gLong) * Exp(1.0));
  gLong := Trunc(Ln(Abs(gLong) + 1.0)); gLong := Random(10);
  Move(Buf, Buf, SizeOf(Buf)); FillChar(Buf, SizeOf(Buf), 0);
  gStr := FileSearch('x.dat', ''); gLong := FileAge('x.dat');
  gLong := FileGetDate(0); gStr := ExtractFilePath('a\b\c.dat');
  gStr := ChangeFileExt('a.dat', '.txt'); gStr := ExtractFileName(gStr);
  Assign(F, 'x.txt'); Rewrite(F); WriteLn(F, gStr); Close(F);
  Assign(F, 'x.txt'); Reset(F); ReadLn(F, gStr); Close(F);
  Assign(U, 'x.txt'); Reset(U, 1); BlockRead(U, Buf, SizeOf(Buf), gCount); Close(U);
  Assign(U, 'x.txt'); Rewrite(U, 1); BlockWrite(U, Buf, SizeOf(Buf)); Close(U);
end;



